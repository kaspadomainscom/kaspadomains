# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# With these set, Supabase becomes the primary store for listings, votes and
# categories. Leave them unset and the app falls back to reading the Kasplex
# contracts exactly as before (which currently fail — see docs/BUGS.md).
#
# Set up: create a project at https://supabase.com, run supabase/schema.sql in
# its SQL editor, then copy the values from Project Settings → API.

# Project API URL, e.g. https://abcdefghijklm.supabase.co
# Also added to the CSP connect-src allowlist automatically.
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose to the browser: under the RLS
# policies in supabase/schema.sql it can read public data and cannot write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER ONLY — it bypasses Row Level Security.
# Never prefix this with NEXT_PUBLIC_, never import it into a client component.
# Without it the app is read-only: listing, voting and editing resources are
# disabled rather than silently failing.
SUPABASE_SERVICE_ROLE_KEY=
