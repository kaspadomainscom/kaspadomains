# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# With these set, Supabase becomes the primary store for listings, votes and
# categories. Leave them unset and the app falls back to reading the Kasplex
# contracts exactly as before (which currently fail — see docs/BUGS.md).
#
# Set up: create a project at https://supabase.com, run supabase/schema.sql in
# its SQL editor, then copy the values from Project Settings → API.

# Project API URL, e.g. https://abcdefghijklm.supabase.co
# Also added to the CSP connect-src allowlist automatically.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (newer projects: sb_publishable_…; older: the "anon" JWT).
# Safe to expose to the browser: under the RLS policies in supabase/schema.sql
# it can read public data and cannot write. Either variable name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (newer projects: sb_secret_…; older: "service_role").
# SERVER ONLY — it bypasses Row Level Security. Never prefix it with
# NEXT_PUBLIC_, never import it into a client component, never paste it into a
# chat or a commit. Without it the app is read-only: listing, voting and editing
# resources are disabled rather than silently failing. Either name works.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# The Kaspa L1 address that listing (200 KAS) and vote (1 KAS) fees are paid to.
# Public by necessity — the browser builds the payment from it — and re-read
# server-side when verifying, so a tampered client value just fails the check.
# Until it is set, paid actions are disabled rather than silently free.
NEXT_PUBLIC_KASPADOMAINS_TREASURY_ADDRESS=
